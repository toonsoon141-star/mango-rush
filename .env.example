# Copy this file to .env and fill in your values
# (or set these as environment variables on your hosting platform)

# --- From @BotFather ---
BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=Mango_Rush0_bot

# --- Mini app short name (BotFather /newapp, default "app") ---
APP_SHORT=app

# --- Your deployed HTTPS URL ---
APP_URL=https://your-app.example.com

# --- Database (optional, but REQUIRED to keep data safe on free hosts) ---
# Keep the SQLite DB on Turso (free tier, https://turso.tech) instead of the
# container's temporary disk. Without these, data.db is lost on every redeploy.
# LIBSQL_URL=libsql://your-db-name-your-org.turso.io
# LIBSQL_AUTH_TOKEN=eyJhbGciOi...  (generate in the Turso dashboard/CLI)
# LIBSQL_SYNC_PERIOD=1             (auto-sync seconds, default 1)
# DB_PATH=/app/data.db             (local replica file path, default ./data.db)

# --- Demo/preview mode ---
# Set DEMO_MODE=1 only for local preview (skips Telegram initData verification).
# REMOVE this line (or set 0) in production.
DEMO_MODE=1

# --- Admin panel ---
# Admins are seeded on first run from config.js (ADMIN_SEED) with
# username + password. Change passwords from the admin panel itself.
# Only these usernames can log in.

# --- Withdraw (USDT BEP-20) ---
# Channel where new withdraw requests + "Payment Sent" proofs are posted
# (the bot must be an ADMIN in this channel)
WITHDRAW_CHANNEL=@MangoRush_Proof
# Minimum withdraw (USDT) — default 0.1 (= 1000 Mango)
MIN_WITHDRAW_USDT=0.1
# Fixed withdraw fee % — default 20%
WITHDRAW_FEE_PCT=20

# --- Optional ---
APP_NAME=MANGO RUSH
PORT=3000
